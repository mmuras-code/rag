# Copy to .env (git-ignored); `just` loads it. Values below are the defaults unless marked required.

# Required: the agent's model calls go through OpenRouter (../llm/). https://openrouter.ai/settings/keys
OR_KEY=
# The agent's model, one of the OpenRouterModel values in ../llm/src/llm/openrouter.py.
LLM_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# The gRPC port this service listens on, and where the search service listens.
AGENT_PORT=8002
SEARCH_ADDRESS=127.0.0.1:8001
# The judge: llm, word_limit or aggregate (see README.md), and the LLM judge's model.
AGENT_JUDGE=llm
AGENT_JUDGE_MODEL=anthropic/claude-sonnet-5.5
# Cosine similarity under which a search result is dropped as junk. Check with `just eval retrieval`.
AGENT_MIN_SIMILARITY=0.2
