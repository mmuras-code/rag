# Log cleaner (python -m common.log_cleaner; `just log-cleaner-up` loads this file).
# Every setting is optional: unset means the default shown.
# Delete log files whose name time is older than this.
LOG_CLEANUP_MAX_AGE_HOURS=24
# How often the cleaner runs.
LOG_CLEANUP_INTERVAL_MINUTES=60
# Logging settings (LOG_LEVEL, LOG_ROLL_MINUTES, LOG_MAX_MB, ...) are read by each service from its
# own environment or .env; see README.md#logging.
