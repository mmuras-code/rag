# Copy to .env (git-ignored) and adjust. Values below are the defaults unless marked required.

# Required for OpenRouterClient and embed. Create one at https://openrouter.ai/settings/keys.
OR_KEY=
# One of the OpenRouterModel values in src/llm/openrouter.py.
LLM_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
LLM_EMBED_MODEL=openai/text-embedding-3-small
LLM_EMBED_MAX_TOKENS=8191
# Request timeouts in seconds: chat and streaming, and embed.
LLM_TIMEOUT_S=120
LLM_EMBED_TIMEOUT_S=30
