# Copy to .env (git-ignored); `just` loads it. Values below are the defaults.
ORCHESTRATOR_URL=http://127.0.0.1:8000
# Only if the orchestrator requires a key.
ORCHESTRATOR_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# The search service (gRPC), for `just retrieval`.
SEARCH_ADDRESS=127.0.0.1:8001
# The vault root and collections search indexes; tests/test_grounding.py reads them (read-only)
# to check grounding.jsonl and vault_facts.jsonl. Set them to match search's.
SEARCH_VAULT_PATH=~/Documents/obsidian_git/Personal/knowledge_database
SEARCH_COLLECTIONS=ml,test
