{
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "skipUrlSync": false,
        "query": "label_values(ml_operations_total, job)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "skipUrlSync": false,
        "query": "label_values(ml_operations_total{job=~\"$service\"}, instance)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      },
      {
        "type": "query",
        "name": "operation",
        "label": "Operation",
        "skipUrlSync": false,
        "query": "label_values(ml_operations_total{job=~\"$service\", instance=~\"$instance\"}, operation)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
  },
  "annotations": {},
  "uid": "ml-operations",
  "title": "ML operations",
  "description": "Request count, latency, errors, faults and failures of every operation. Generated by observability/grafana/dashboard.py; edit that, not the UI.",
  "tags": [
    "ml",
    "observability"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 0,
      "panels": [],
      "title": "Overview (selected time range)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(ml_operations_total{job=~\"$service\", instance=~\"$instance\", operation=~\"$operation\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "title": "Requests",
      "description": "Operations finished in the range.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(ml_operations_total{job=~\"$service\", instance=~\"$instance\", operation=~\"$operation\", outcome=\"success\"}[$__range])) / sum(increase(ml_operations_total{job=~\"$service\", instance=~\"$instance\", operation=~\"$operation\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
