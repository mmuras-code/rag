# Copy to .env (git-ignored) and adjust. Everything except OR_KEY (below) is optional;
# these are the defaults.
# The vault root; only the collection folders under it are read (common.collection.Collection).
SEARCH_VAULT_PATH=~/Documents/obsidian_git/Personal/knowledge_database
SEARCH_COLLECTIONS=ml,test
SEARCH_DATABASE_URL=postgresql://search:search@127.0.0.1:5433/search
SEARCH_PORT=8001
LLM_EMBED_MODEL=openai/text-embedding-3-small
LLM_EMBED_MAX_TOKENS=8191

# Required: embeddings go through OpenRouter. Create one at https://openrouter.ai/settings/keys.
OR_KEY=
